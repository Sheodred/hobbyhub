.env

# api (PHP) - production credentials, never committed (see api/config.example.php)
api/config.local.php
api/vendor/
api/.phpunit.result.cache


# frontend
frontend/node_modules/
frontend/dist/
# Vite dev-server output, rewritten on every local run - it sat untracked long
# enough that "never git add -A in this repo" became a rule people had to
# remember. Ignoring it is cheaper than remembering.
frontend/dev-server.log
# Vendored by scripts/copy-stockfish.js (postinstall) - a ~7MB WASM binary,
# reproduced on every install rather than committed.
frontend/public/stockfish/

# IDE
.idea/
.vscode/
/db/

# Claude Code - settings.json (shared hook config) is committed,
# settings.local.json (personal permissions) is not.
.claude/settings.local.json

# graphify - regenerable knowledge graph, not source.
graphify-out/

# Claude Code - local skill scaffolding and machine-specific MCP config,
# regenerated by the skill installer / IDE plugin, not source.
.mcp.json
.claude/.headroom_wrap_marker.json
.agents/
.claude/skills/
skills-lock.json
.serena/

# Handoff docs belong in C:\Users\<user>\.claude\handoff\, not in the repo
# (see CLAUDE.md). Safety net for one landing here by accident. Note: the
# current naming (<YYYY-MM-DD>T<HHMM>-<slug>.md) has no fixed token to glob,
# so a stray new-style handoff won't be caught here — watch for it by eye.
# *-handoff.md still catches the temp default (hobbyhub-handoff.md).
*-handoff.md
