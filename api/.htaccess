# Error pages (#166). This directory declares its own RewriteEngine, and
# Apache's per-directory rewrite context does NOT inherit the parent's rules -
# so the docroot .htaccess rule that serves index.html for unknown paths (and
# with it React Router's styled 404 card) never runs under /api/. Without
# these three lines, every unmatched path here fell through to Apache's stock
# iso-8859-1 error pages instead.
#
# The target must stay a LOCAL PATH, not a full URL: a local path keeps the
# original 403/404 status, while an "https://..." target turns the response
# into a 302 - which is worse than the stock page, not better.
#
# API callers are unaffected: apiClient.ts already catches a non-JSON error
# body and throws ApiError(status, "Request failed"), so a fetch() that 404s
# still gets the right status and a typed error, whatever the body is.
#
# Deliberately NOT "Options -Indexes", even though /api/ and /api/boardgames/
# are real directories. Their 403 already proves listing is denied on IONOS -
# an enabled Indexes would have returned a listing, not a Forbidden - so the
# directive would change nothing, and `Options` needs AllowOverride Options,
# which is a different (unproven) class from the FileInfo that RewriteRule and
# ErrorDocument use. If IONOS does not grant it, Apache answers 500 for this
# whole directory: a real outage traded for no gain. ErrorDocument alone is
# safe by the same reasoning inverted - the rewrites below are FileInfo and
# demonstrably work, so FileInfo is granted.
ErrorDocument 403 /index.html
ErrorDocument 404 /index.html

RewriteEngine On

# Never allow direct web access to config/lib/cron/sql, or to the test
# suite/Composer tooling (tests/, vendor/, composer.json/lock) - none of
# these are ever requested directly, only included or run via CLI/WebCron.
RewriteRule ^(config|config\.local|lib/.*|cron/.*|sql/.*|tests/.*|vendor/.*|composer\.(json|lock))$ - [F,END]

# Static routes - extensionless URL -> the matching .php file. Order
# matters: the more specific /mtg/cards/by-name rule must come before the
# generic /mtg/cards/{id} catch-all below it. Every rule uses END (not just
# L) because .htaccess per-directory rewriting restarts matching against the
# rewritten URI - without END, "mtg/cards/by-name" rewrites to
# "mtg/cards/by-name.php", which then re-enters the ruleset and matches the
# generic {id} catch-all below, turning into
# "mtg/cards/get.php?id=by-name.php". END stops that restart.
RewriteRule ^mtg/search/?$ mtg/search.php [QSA,END]
RewriteRule ^mtg/printings/?$ mtg/printings.php [QSA,END]
RewriteRule ^mtg/cards/by-name/?$ mtg/cards/by-name.php [QSA,END]
RewriteRule ^mtg/combos/?$ mtg/combos.php [QSA,END]
RewriteRule ^mtg/meta/?$ mtg/meta.php [QSA,END]
RewriteRule ^mtg/archetype-decks/?$ mtg/archetype-decks.php [QSA,END]
RewriteRule ^boardgames/lookup/?$ boardgames/lookup.php [QSA,END]
RewriteRule ^boardgames/suggest/?$ boardgames/suggest.php [QSA,END]
RewriteRule ^boardgames/local/?$ boardgames/local.php [QSA,END]
RewriteRule ^boardgames/top/?$ boardgames/top.php [QSA,END]
RewriteRule ^boardgames/random/?$ boardgames/random.php [QSA,END]
RewriteRule ^boardgames/awards/?$ boardgames/awards.php [QSA,END]
RewriteRule ^news/tagesschau/?$ news/tagesschau.php [QSA,END]
RewriteRule ^news/wotc/?$ news/wotc.php [QSA,END]
RewriteRule ^news/dortmund/?$ news/dortmund.php [QSA,END]
RewriteRule ^news/fleamarket/?$ news/fleamarket.php [QSA,END]
RewriteRule ^health/?$ health.php [QSA,END]

# Dynamic routes: /mtg/cards/{id} and /mtg/decks/{id} - anything not already
# matched above.
RewriteRule ^mtg/cards/([^/]+)/?$ mtg/cards/get.php?id=$1 [QSA,END]
RewriteRule ^mtg/decks/([^/]+)/?$ mtg/decks/get.php?id=$1 [QSA,END]
